# Port d'écoute du serveur Backend API
PORT=5000

# Clé secrète pour signer les JWT
JWT_SECRET=super_secret_jwt_key_taskflow_2026_change_in_production
JWT_EXPIRES_IN=24h

# Configuration de l'Architecture Hybride
# Option A (Cahier des charges standard) : Communication avec la Passerelle Locale via Cloudflare Tunnel
GATEWAY_URL=https://votre-tunnel.trycloudflare.com
GATEWAY_SECRET=taskflow_shared_secret_2026

# Option B (Connexion directe à PostgreSQL si souhaité)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow_db

# Origines autorisées pour CORS (ex: URL du Frontend Next.js sur Vercel)
FRONTEND_URL=*
