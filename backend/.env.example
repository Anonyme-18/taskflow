# Port d'écoute du serveur Backend API
PORT=5000

# Clé secrète pour signer les JWT
JWT_SECRET=super_secret_jwt_key_taskflow_2026_change_in_production
JWT_EXPIRES_IN=24h

# Configuration de l'Architecture Hybride (si connecté à la passerelle de votre coéquipier)
